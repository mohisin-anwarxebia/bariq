# BARIQ Demo Configuration

# AI Provider: mock | openai
AI_PROVIDER=mock

# OpenAI (optional - enables real AI vision for bottle recognition)
# Without this key, vision uses demo/mock data based on filename hints
# With this key, upload ANY bottle photo for real brand ID + fill estimation
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

# Ticketmaster Discovery API v2 (optional - enables live event data)
# Get a free key at: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# Database
DATABASE_URL=sqlite:///./bariq_demo.db

# Demo Mode
DEMO_MODE=true

# Server
BACKEND_PORT=8000
FRONTEND_PORT=3000
